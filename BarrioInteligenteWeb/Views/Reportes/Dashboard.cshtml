@using BarrioInteligenteWeb.Models
@using BarrioInteligenteWeb.Helpers
@using BarrioInteligenteWeb.Services
@{
    Layout = null;
    ViewData["Title"] = "Panel de Control Urbano";
    ViewData["ActiveTab"] = "Dashboard";

    bool esStaff = (ViewBag.EsStaff != null && (bool)ViewBag.EsStaff) || (ViewBag.EsAdmin != null && (bool)ViewBag.EsAdmin);

    int totalReportes = ViewBag.TotalReportes ?? 0;
    int totalPendientes = ViewBag.TotalPendientes ?? 0;
    int totalEnProceso = ViewBag.TotalEnProceso ?? 0;
    int totalResueltos = ViewBag.TotalResueltos ?? 0;
    double tasaResolucion = ViewBag.TasaResolucion ?? 0.0;

    int totalUsuarios = ViewBag.TotalUsuarios ?? 0;
    int repExcelente = ViewBag.RepExcelente ?? 0;
    int repBuena = ViewBag.RepBuena ?? 0;
    int repRegular = ViewBag.RepRegular ?? 0;
    int repMala = ViewBag.RepMala ?? 0;
    int repCritica = ViewBag.RepCritica ?? 0;

    var topCiudadanos = ViewBag.TopCiudadanos as List<Usuario> ?? new List<Usuario>();
    var reportesRecientes = ViewBag.ReportesRecientes as List<Reporte> ?? new List<Reporte>();

    Func<int, double> pctUsuarios = (count) => totalUsuarios > 0 ? Math.Round(count * 100.0 / totalUsuarios, 1) : 0.0;
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <title>@ViewData["Title"] — Barrio Inteligente</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/barrio.css" asp-append-version="true" />
    <style>
        .kpi-card {
            background: #ffffff;
            border: 1px solid #e5e7eb;
            transition: transform 0.15s ease, box-shadow 0.15s ease;
        }
        .kpi-card:hover {
            transform: translateY(-2px);
            box-shadow: 0 6px 18px rgba(15, 23, 42, 0.06) !important;
        }
        .kpi-label {
            font-size: 11px;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            color: #6b7280;
        }
        .kpi-value {
            font-size: 28px;
            font-weight: 800;
            color: #111827;
            line-height: 1.15;
        }
        .kpi-pill {
            font-size: 11px;
            font-weight: 600;
            padding: 3px 10px;
            border-radius: 9999px;
            display: inline-flex;
            align-items: center;
            gap: 4px;
        }
        .rep-bar-track {
            height: 8px;
            background: #f1f5f9;
            border-radius: 9999px;
            overflow: hidden;
        }
        .rep-bar-fill {
            height: 100%;
            border-radius: 9999px;
            transition: width 0.3s ease;
        }
        .badge-estado-tbl {
            display: inline-flex;
            align-items: center;
            font-size: 11px;
            font-weight: 700;
            padding: 4px 10px;
            border-radius: 9999px;
            border: 1.5px solid #cbd5e1;
            white-space: nowrap;
        }
        .badge-estado-tbl.pendiente {
            background: #fffbeb;
            border-color: #fbbf24;
            color: #b45309;
        }
        .badge-estado-tbl.en-proceso {
            background: #eff6ff;
            border-color: #60a5fa;
            color: #1d4ed8;
        }
        .badge-estado-tbl.resuelto {
            background: #ecfdf5;
            border-color: #34d399;
            color: #065f46;
        }
        .btn-equipos-cta {
            background: #111827;
            color: #ffffff !important;
            border: 1px solid #111827;
            font-size: 13px;
            font-weight: 600;
            padding: 9px 16px;
            border-radius: 10px;
            text-decoration: none;
            display: inline-flex;
            align-items: center;
            gap: 6px;
            transition: background 0.15s ease, transform 0.15s ease;
            white-space: nowrap;
        }
        .btn-equipos-cta:hover {
            background: #1f2937;
            transform: translateY(-1px);
            color: #ffffff !important;
        }
        .dash-select-estado {
            min-width: 135px;
            font-size: 12.5px;
            font-weight: 600;
            border-radius: 10px;
            border: 1.5px solid #e2e8f0;
            background-color: #f8fafc;
            color: #111827;
        }
        .dash-select-estado:focus {
            border-color: #111827;
            box-shadow: none;
        }
        #dashToast {
            position: fixed;
            bottom: 80px;
            left: 50%;
            transform: translateX(-50%);
            background: #111827;
            color: #ffffff;
            font-size: 13px;
            font-weight: 600;
            padding: 10px 20px;
            border-radius: 9999px;
            box-shadow: 0 8px 24px rgba(15, 23, 42, 0.22);
            z-index: 9999;
            display: none;
        }
    </style>
</head>
<body>
    <div class="app-screen">
        @await Html.PartialAsync("_AppHeader")
        @Html.AntiForgeryToken()

        <div class="page-container">
            <div class="container-fluid p-0">
                <!-- Encabezado -->
                <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
                    <div>
                        <h4 class="fw-bold text-dark mb-1">Panel de Control Urbano</h4>
                        <p class="text-muted mb-0">Análisis, salud cívica y gestión operativa en tiempo real</p>
                    </div>
                    @if (esStaff)
                    {
                        <a href="/Equipos" class="btn-equipos-cta">
                            <span>Coordinar con Equipos →</span>
                        </a>
                    }
                </div>

                <!-- 4 Tarjetas KPI -->
                <div class="row g-3 mb-4">
                    <div class="col-6 col-lg-3">
                        <div class="card kpi-card shadow-sm rounded-4 h-100">
                            <div class="card-body p-3 p-md-4 d-flex flex-column justify-content-between">
                                <span class="kpi-label mb-2">Total Reportes</span>
                                <div class="kpi-value mb-2" id="kpiTotal">@totalReportes</div>
                                <span class="kpi-pill" style="background:#f3f4f6;color:#374151;width:fit-content;">
                                    📍 Historial activo
                                </span>
                            </div>
                        </div>
                    </div>
                    <div class="col-6 col-lg-3">
                        <div class="card kpi-card shadow-sm rounded-4 h-100">
                            <div class="card-body p-3 p-md-4 d-flex flex-column justify-content-between">
                                <span class="kpi-label mb-2">Pendientes</span>
                                <div class="kpi-value mb-2" id="kpiPendientes">@totalPendientes</div>
                                <span class="kpi-pill" style="background:#fffbeb;color:#b45309;width:fit-content;">
                                    ⏳ Por atender
                                </span>
                            </div>
                        </div>
                    </div>
                    <div class="col-6 col-lg-3">
                        <div class="card kpi-card shadow-sm rounded-4 h-100">
                            <div class="card-body p-3 p-md-4 d-flex flex-column justify-content-between">
                                <span class="kpi-label mb-2">En Proceso</span>
                                <div class="kpi-value mb-2" id="kpiEnProceso">@totalEnProceso</div>
                                <span class="kpi-pill" style="background:#eff6ff;color:#1d4ed8;width:fit-content;">
                                    🛠️ En atención
                                </span>
                            </div>
                        </div>
                    </div>
                    <div class="col-6 col-lg-3">
                        <div class="card kpi-card shadow-sm rounded-4 h-100">
                            <div class="card-body p-3 p-md-4 d-flex flex-column justify-content-between">
                                <span class="kpi-label mb-2">Resueltos</span>
                                <div class="kpi-value mb-2" id="kpiResueltos">@totalResueltos</div>
                                <span class="kpi-pill" style="background:#ecfdf5;color:#065f46;width:fit-content;">
                                    ✅ <span id="kpiTasaResolucion">@tasaResolucion%</span> resolución
                                </span>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Gráficos Chart.js -->
                <div class="row g-4 mb-4">
                    <div class="col-12 col-lg-6">
                        <div class="card shadow-sm h-100 border-0 rounded-4 bg-white">
                            <div class="card-body p-4">
                                <h5 class="card-title fw-bold text-dark mb-1">Reportes por Categoría</h5>
                                <p class="text-muted small mb-4">Distribución de incidencias reportadas</p>
                                <div class="position-relative" style="height: 290px;">
                                    <canvas id="chartCategorias"></canvas>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="col-12 col-lg-6">
                        <div class="card shadow-sm h-100 border-0 rounded-4 bg-white">
                            <div class="card-body p-4">
                                <h5 class="card-title fw-bold text-dark mb-1">Estado de los Reportes</h5>
                                <p class="text-muted small mb-4">Seguimiento operativo por fase de atención</p>
                                <div class="position-relative" style="height: 290px;">
                                    <canvas id="chartEstados"></canvas>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Salud Cívica + Ciudadanos Destacados -->
                <div class="row g-4 mb-4">
                    <div class="col-12 col-lg-5">
                        <div class="card shadow-sm h-100 border-0 rounded-4 bg-white">
                            <div class="card-body p-4">
                                <div class="d-flex justify-content-between align-items-center mb-1">
                                    <h5 class="card-title fw-bold text-dark mb-0">Salud Cívica</h5>
                                    <span class="badge bg-light text-dark border rounded-pill">@totalUsuarios ciudadanos</span>
                                </div>
                                <p class="text-muted small mb-4">Distribución de reputación (0–40 pts = Regular)</p>

                                @{
                                    var nivelesSalud = new[]
                                    {
                                        new { Nombre = "Excelente", Rango = "> 80 pts", Count = repExcelente, Color = "#10B981", Bg = "#ecfdf5", Text = "#065f46" },
                                        new { Nombre = "Buena", Rango = "41–80 pts", Count = repBuena, Color = "#3B82F6", Bg = "#eff6ff", Text = "#1d4ed8" },
                                        new { Nombre = "Regular", Rango = "0–40 pts · Estándar", Count = repRegular, Color = "#6B7280", Bg = "#f3f4f6", Text = "#374151" },
                                        new { Nombre = "Mala", Rango = "-1 a -49 pts", Count = repMala, Color = "#F59E0B", Bg = "#fffbeb", Text = "#b45309" },
                                        new { Nombre = "Crítica", Rango = "≤ -50 pts", Count = repCritica, Color = "#EF4444", Bg = "#fef2f2", Text = "#b91c1c" }
                                    };
                                }

                                <div class="d-flex flex-column gap-3">
                                    @foreach (var niv in nivelesSalud)
                                    {
                                        var pct = pctUsuarios(niv.Count);
                                        <div>
                                            <div class="d-flex justify-content-between align-items-center mb-1">
                                                <div class="d-flex align-items-center gap-2">
                                                    <span class="fw-semibold text-dark" style="font-size: 13px;">@niv.Nombre</span>
                                                    <span class="text-muted" style="font-size: 11px;">(@niv.Rango)</span>
                                                </div>
                                                <span class="fw-bold" style="font-size: 12.5px; color: @niv.Text;">@niv.Count (@pct%)</span>
                                            </div>
                                            <div class="rep-bar-track">
                                                <div class="rep-bar-fill" style="width: @pct.ToString(System.Globalization.CultureInfo.InvariantCulture)%; background-color: @niv.Color;"></div>
                                            </div>
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="col-12 col-lg-7">
                        <div class="card shadow-sm h-100 border-0 rounded-4 bg-white">
                            <div class="card-body p-4">
                                <h5 class="card-title fw-bold text-dark mb-1">🏆 Ciudadanos Destacados</h5>
                                <p class="text-muted small mb-4">Vecinos con mayor puntuación cívica verificada</p>

                                <div class="row g-3">
                                    @foreach (var usuario in topCiudadanos)
                                    {
                                        var nivelReal = ProfanityService.CalcularNivel(usuario.PuntosReputacion);
                                        var badgeColor = nivelReal switch {
                                            NivelReputacion.Excelente => "bg-success",
                                            NivelReputacion.Buena => "bg-primary",
                                            NivelReputacion.Regular => "bg-secondary",
                                            NivelReputacion.Mala => "bg-warning text-dark",
                                            NivelReputacion.Critica => "bg-danger",
                                            _ => "bg-secondary"
                                        };
                                        var inicial = !string.IsNullOrWhiteSpace(usuario.NombreCompleto)
                                            ? usuario.NombreCompleto.Substring(0, 1).ToUpper()
                                            : "U";

                                        <div class="col-12 col-md-4">
                                            <div class="p-3 border rounded-4 d-flex align-items-center bg-light-subtle h-100">
                                                <div class="me-3 position-relative flex-shrink-0">
                                                    @if (!string.IsNullOrEmpty(usuario.FotoPerfil))
                                                    {
                                                        <img src="@usuario.FotoPerfil" alt="@usuario.NombreCompleto" class="rounded-circle border border-2 border-white shadow-sm" style="width: 48px; height: 48px; object-fit: cover;">
                                                    }
                                                    else
                                                    {
                                                        <div class="rounded-circle shadow-sm d-flex align-items-center justify-content-center text-white fw-bold @badgeColor" style="width: 48px; height: 48px; font-size: 1.1rem;">
                                                            @inicial
                                                        </div>
                                                    }
                                                    <span class="position-absolute bottom-0 start-100 translate-middle p-1 bg-white border border-light rounded-circle" title="@nivelReal">
                                                        <span class="badge @badgeColor rounded-circle p-1" style="width: 13px; height: 13px; display: inline-block;"></span>
                                                    </span>
                                                </div>
                                                <div class="overflow-hidden">
                                                    <h6 class="mb-1 fw-bold text-dark text-truncate">@usuario.NombreCompleto</h6>
                                                    <small class="text-muted d-block fw-medium">@usuario.PuntosReputacion pts • @nivelReal</small>
                                                </div>
                                            </div>
                                        </div>
                                    }
                                    @if (!topCiudadanos.Any())
                                    {
                                        <div class="col-12">
                                            <p class="text-muted mb-0">No hay ciudadanos destacados aún.</p>
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Gestión Rápida de Reportes (Solo Staff/Admin) -->
                @if (esStaff)
                {
                    <div class="card shadow-sm border-0 rounded-4 bg-white">
                        <div class="card-header bg-white border-bottom px-4 py-3 d-flex flex-wrap justify-content-between align-items-center gap-3 rounded-top-4">
                            <div>
                                <h5 class="fw-bold text-dark mb-0">Gestión Rápida de Reportes</h5>
                                <small class="text-muted">Actualiza el estado de los reportes recientes y recompensa (+10 pts) al resolverlos</small>
                            </div>
                            <a href="/Equipos" class="btn-equipos-cta">
                                <span>Coordinar con Equipos →</span>
                            </a>
                        </div>
                        <div class="card-body p-0">
                            @if (!reportesRecientes.Any())
                            {
                                <div class="p-4 text-center text-muted small">
                                    No hay reportes registrados todavía.
                                </div>
                            }
                            else
                            {
                                <div class="table-responsive">
                                    <table class="table table-hover align-middle mb-0">
                                        <thead class="table-light">
                                            <tr style="font-size: 11.5px; text-transform: uppercase; letter-spacing: 0.4px; color: #6b7280;">
                                                <th class="ps-4 py-3">Reporte</th>
                                                <th class="py-3">Categoría</th>
                                                <th class="py-3">Ciudadano</th>
                                                <th class="py-3">Estado</th>
                                                <th class="py-3">Actualizar Estado</th>
                                                <th class="pe-4 py-3 text-end">Detalle</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var rep in reportesRecientes)
                                            {
                                                var estadoRep = string.IsNullOrWhiteSpace(rep.Estado) ? "Pendiente" : rep.Estado;
                                                var estadoCss = estadoRep == "Resuelto" ? "resuelto" : (estadoRep == "En Proceso" ? "en-proceso" : "pendiente");
                                                var autorNombre = rep.Usuario?.NombreCompleto ?? "Ciudadano";
                                                var tiempo = TiempoHelper.TiempoRelativo(rep.Fecha);
                                                <tr>
                                                    <td class="ps-4 py-3" style="max-width: 280px;">
                                                        <div class="fw-semibold text-dark text-truncate">@rep.Titulo</div>
                                                        <small class="text-muted">@tiempo • 👍 @rep.Upvotes</small>
                                                    </td>
                                                    <td class="py-3">
                                                        <span class="badge bg-light text-dark border fw-semibold">@rep.Categoria</span>
                                                    </td>
                                                    <td class="py-3 text-muted small">@autorNombre</td>
                                                    <td class="py-3">
                                                        <span class="badge-estado-tbl @estadoCss" id="dash-badge-@rep.Id">@estadoRep</span>
                                                    </td>
                                                    <td class="py-3">
                                                        <select class="form-select form-select-sm dash-select-estado"
                                                                data-reporte-id="@rep.Id"
                                                                data-estado-actual="@estadoRep"
                                                                aria-label="Cambiar estado de reporte @rep.Id">
                                                            <option value="Pendiente" selected="@(estadoRep == "Pendiente")">Pendiente</option>
                                                            <option value="En Proceso" selected="@(estadoRep == "En Proceso")">En Proceso</option>
                                                            <option value="Resuelto" selected="@(estadoRep == "Resuelto")">Resuelto</option>
                                                        </select>
                                                    </td>
                                                    <td class="pe-4 py-3 text-end">
                                                        <a href="@Url.Action("Detalles", "Reportes", new { id = rep.Id })"
                                                           class="btn btn-sm btn-outline-dark rounded-3 fw-semibold">
                                                            Ver
                                                        </a>
                                                    </td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            }
                        </div>
                    </div>
                }
            </div>
        </div>

        @await Html.PartialAsync("_BottomNav")
        <div id="dashToast"></div>
    </div>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const dataCategorias = @Html.Raw(ViewBag.DataCategorias ?? "[]");
            const dataEstados = @Html.Raw(ViewBag.DataEstados ?? "[]");

            const estadoCounts = {
                'Pendiente': @totalPendientes,
                'En Proceso': @totalEnProceso,
                'Resuelto': @totalResueltos
            };

            const estadoColores = {
                'Pendiente': '#F59E0B',
                'En Proceso': '#3B82F6',
                'Resuelto': '#10B981'
            };

            // Gráfico Categorías (Doughnut)
            const ctxCat = document.getElementById('chartCategorias').getContext('2d');
            new Chart(ctxCat, {
                type: 'doughnut',
                data: {
                    labels: dataCategorias.map(d => d.Categoria || d.categoria),
                    datasets: [{
                        data: dataCategorias.map(d => d.Count || d.count),
                        backgroundColor: ['#10B981', '#3B82F6', '#F59E0B', '#EF4444', '#8B5CF6'],
                        borderWidth: 0,
                        hoverOffset: 6
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: {
                            position: 'bottom',
                            labels: {
                                font: { family: "'Inter', sans-serif", size: 13 },
                                usePointStyle: true,
                                padding: 20
                            }
                        }
                    },
                    cutout: '70%',
                    layout: { padding: 10 }
                }
            });

            // Gráfico Estados (Bar con colores semánticos)
            const labelsEstados = dataEstados.length > 0
                ? dataEstados.map(d => d.Estado || d.estado)
                : ['Pendiente', 'En Proceso', 'Resuelto'];
            const valuesEstados = dataEstados.length > 0
                ? dataEstados.map(d => d.Count ?? d.count ?? 0)
                : [estadoCounts['Pendiente'], estadoCounts['En Proceso'], estadoCounts['Resuelto']];

            const ctxEst = document.getElementById('chartEstados').getContext('2d');
            const chartEstadosInstance = new Chart(ctxEst, {
                type: 'bar',
                data: {
                    labels: labelsEstados,
                    datasets: [{
                        label: 'Reportes',
                        data: valuesEstados,
                        backgroundColor: labelsEstados.map(lbl => estadoColores[lbl] || '#6B7280'),
                        borderRadius: 8,
                        barThickness: 'flex',
                        maxBarThickness: 52
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: { legend: { display: false } },
                    scales: {
                        y: {
                            beginAtZero: true,
                            ticks: { precision: 0, font: { family: "'Inter', sans-serif" } },
                            grid: { borderDash: [5, 5], color: '#e5e7eb' },
                            border: { display: false }
                        },
                        x: {
                            grid: { display: false },
                            ticks: { font: { family: "'Inter', sans-serif", weight: '600' } },
                            border: { display: false }
                        }
                    },
                    layout: { padding: { top: 10, bottom: 10 } }
                }
            });

            // Toast helper
            let dashToastTimer = null;
            function showDashToast(msg) {
                const toast = document.getElementById('dashToast');
                if (!toast) return;
                toast.textContent = msg;
                toast.style.display = 'block';
                if (dashToastTimer) clearTimeout(dashToastTimer);
                dashToastTimer = setTimeout(() => {
                    toast.style.display = 'none';
                }, 3200);
            }

            function getEstadoClass(est) {
                if (est === 'Resuelto') return 'resuelto';
                if (est === 'En Proceso') return 'en-proceso';
                return 'pendiente';
            }

            function refreshKpisAndChart() {
                const total = estadoCounts['Pendiente'] + estadoCounts['En Proceso'] + estadoCounts['Resuelto'];
                const tasa = total > 0 ? Math.round((estadoCounts['Resuelto'] * 1000) / total) / 10 : 0;

                const elPend = document.getElementById('kpiPendientes');
                const elProc = document.getElementById('kpiEnProceso');
                const elRes = document.getElementById('kpiResueltos');
                const elTasa = document.getElementById('kpiTasaResolucion');

                if (elPend) elPend.textContent = estadoCounts['Pendiente'];
                if (elProc) elProc.textContent = estadoCounts['En Proceso'];
                if (elRes) elRes.textContent = estadoCounts['Resuelto'];
                if (elTasa) elTasa.textContent = `${tasa}%`;

                chartEstadosInstance.data.datasets[0].data = chartEstadosInstance.data.labels.map(
                    lbl => estadoCounts[lbl] ?? 0
                );
                chartEstadosInstance.update();
            }

            // Selectores inline en Gestión Rápida de Reportes
            document.querySelectorAll('.dash-select-estado').forEach(select => {
                select.addEventListener('change', async function () {
                    const reporteId = this.dataset.reporteId;
                    const estadoAnterior = this.dataset.estadoActual || 'Pendiente';
                    const nuevoEstado = this.value;
                    const tokenInput = document.querySelector('input[name="__RequestVerificationToken"]');
                    const token = tokenInput ? tokenInput.value : '';

                    this.disabled = true;
                    try {
                        const formData = new FormData();
                        formData.append('id', reporteId);
                        formData.append('nuevoEstado', nuevoEstado);

                        const response = await fetch('@Url.Action("CambiarEstado", "Reportes")', {
                            method: 'POST',
                            headers: {
                                'RequestVerificationToken': token,
                                'X-Requested-With': 'XMLHttpRequest'
                            },
                            body: formData
                        });

                        const data = await response.json();
                        if (response.ok && data.success) {
                            const badge = document.getElementById(`dash-badge-${reporteId}`);
                            if (badge) {
                                badge.classList.remove('pendiente', 'en-proceso', 'resuelto');
                                badge.classList.add(getEstadoClass(data.estado));
                                badge.textContent = data.estado;
                            }
                            if (estadoAnterior !== data.estado) {
                                if (Object.prototype.hasOwnProperty.call(estadoCounts, estadoAnterior)) {
                                    estadoCounts[estadoAnterior] = Math.max(0, estadoCounts[estadoAnterior] - 1);
                                }
                                if (Object.prototype.hasOwnProperty.call(estadoCounts, data.estado)) {
                                    estadoCounts[data.estado] += 1;
                                }
                                refreshKpisAndChart();
                            }
                            this.dataset.estadoActual = data.estado;
                            this.value = data.estado;
                            showDashToast(`✓ ${data.message || 'Estado actualizado'}`);
                        } else {
                            this.value = estadoAnterior;
                            showDashToast(`✕ ${data.message || 'Error al actualizar estado'}`);
                        }
                    } catch (err) {
                        console.error('Error al cambiar estado en Dashboard:', err);
                        this.value = estadoAnterior;
                        showDashToast('✕ Error de conexión al actualizar estado');
                    } finally {
                        this.disabled = false;
                    }
                });
            });
        });
    </script>
</body>
</html>
