@using BarrioInteligenteWeb.Helpers
@using BarrioInteligenteWeb.Models
@using System.Security.Claims
@model BarrioInteligenteWeb.Models.ReporteDetalleViewModel
@{
    Layout = null;
    ViewData["Title"] = Model.Reporte.Titulo;
    var estado = string.IsNullOrWhiteSpace(Model.Reporte.Estado) ? "Pendiente" : Model.Reporte.Estado;
    var badgeClass = estado == "Resuelto" ? "resuelto" : (estado == "En Proceso" ? "en-proceso" : "pendiente");
    bool esStaff = (ViewBag.EsStaff != null && (bool)ViewBag.EsStaff) || (ViewBag.EsAdmin != null && (bool)ViewBag.EsAdmin);
    var tiempoTexto = TiempoHelper.TiempoRelativo(Model.Reporte.Fecha);
    var emoji = Model.Reporte.Categoria switch {
        "Bache"  => "🚧",
        "Basura" => "🗑️",
        "Luz"    => "💡",
        _        => "📍"
    };
    var bgColor = Model.Reporte.Categoria switch {
        "Bache"  => "#f5a623,#d4863a",
        "Basura" => "#7f8c8d,#5a6a6b",
        "Luz"    => "#f9ca24,#d4a017",
        _        => "#636e72,#2d3436"
    };
    var tieneImagen = !string.IsNullOrEmpty(Model.Reporte.ImagenUrl);
    
    int currentUserId = 0;
    if (User.Identity?.IsAuthenticated == true)
    {
        int.TryParse(User.FindFirstValue(ClaimTypes.NameIdentifier), out currentUserId);
    }
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <title>@Model.Reporte.Titulo — Barrio Inteligente</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/barrio.css" asp-append-version="true" />
    <style>
        .comment-form {
            padding: 14px 18px;
            border-top: 1px solid #ebebeb;
            display: flex;
            gap: 10px;
            align-items: flex-end;
            background: #fff;
        }
        .comment-form textarea {
            flex: 1;
            background: #f5f5f5;
            border: 2px solid transparent;
            border-radius: 12px;
            padding: 12px 14px;
            font-size: 13px;
            font-family: 'Inter', sans-serif;
            resize: none;
            outline: none;
            min-height: 44px;
            max-height: 100px;
            color: #111;
            transition: border-color 0.15s;
        }
        .comment-form textarea:focus {
            border-color: #111;
            background: #fff;
        }
        .comment-form button {
            width: 44px;
            height: 44px;
            border-radius: 50%;
            background: #111;
            border: none;
            color: #fff;
            display: flex;
            align-items: center;
            justify-content: center;
            flex-shrink: 0;
            cursor: pointer;
        }
        .staff-estado-box {
            background: #ffffff;
            border: 1px solid #e2e8f0;
            border-radius: 14px;
            padding: 16px 20px;
            margin-bottom: 22px;
            box-shadow: 0 2px 8px rgba(15, 23, 42, 0.04);
        }
        .btn-estado-pill {
            border-radius: 9999px;
            padding: 7px 16px;
            font-size: 13px;
            font-weight: 600;
            border: 1.5px solid #e2e8f0;
            background: #f8fafc;
            color: #334155;
            transition: all 0.15s ease;
            cursor: pointer;
        }
        .btn-estado-pill:hover:not(:disabled) {
            background: #f1f5f9;
            border-color: #cbd5e1;
        }
        .btn-estado-pill.active[data-estado="Pendiente"] {
            background: #fffbeb;
            border-color: #f59e0b;
            color: #b45309;
        }
        .btn-estado-pill.active[data-estado="En Proceso"] {
            background: #eff6ff;
            border-color: #3b82f6;
            color: #1d4ed8;
        }
        .btn-estado-pill.active[data-estado="Resuelto"] {
            background: #ecfdf5;
            border-color: #10b981;
            color: #065f46;
        }
    </style>
</head>
<body>
<div class="app-screen">
    @{
        ViewData["ActiveTab"] = Model.Reporte.TipoPost == "Consulta" ? "Comunidad" : "MisReportes";
    }
    @await Html.PartialAsync("_AppHeader")

    <div class="detalle-page-wrap">
        <div class="detalle-card-container">

            <!-- Portada / Hero -->
            <div class="detail-cover">
                <a href="javascript:history.back()" class="detail-cover-back" aria-label="Volver" title="Volver">
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.2" stroke="currentColor" width="18" height="18">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M10.5 19.5 3 12m0 0 7.5-7.5M3 12h18"/>
                    </svg>
                </a>

                @if (tieneImagen)
                {
                    <img src="@Model.Reporte.ImagenUrl" alt="@Model.Reporte.Titulo"
                         onerror="this.style.display='none';document.getElementById('imgPlaceholder').style.display='flex';" />
                    <div id="imgPlaceholder"
                         style="display:none;width:100%;height:100%;background:linear-gradient(135deg,#1e293b 0%,#0f172a 100%);align-items:center;justify-content:center;font-size:70px;">
                        @emoji
                    </div>
                }
                else
                {
                    <div class="detail-placeholder">
                        <span style="font-size:72px;filter:drop-shadow(0 3px 6px rgba(0,0,0,0.3));">@emoji</span>
                        <span style="font-size:13px;font-weight:600;color:rgba(255,255,255,0.85);text-transform:uppercase;letter-spacing:1px;">@Model.Reporte.Categoria</span>
                    </div>
                }

                <!-- Overlay con contraste blindado contra fondos blancos/claros -->
                <div class="detail-cover-overlay">
                    <div class="d-flex align-items-center gap-2 mb-1 flex-wrap">
                        @if (Model.Reporte.TipoPost == "Consulta")
                        {
                            <span class="badge-tag-overlay badge-consulta">🏘️ CONSULTA VECINAL</span>
                        }
                        else
                        {
                            <span class="badge-tag-overlay badge-categoria">@emoji @Model.Reporte.Categoria</span>
                        }
                        <span class="badge-estado @badgeClass" id="badge-estado-detalle">
                            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor" width="12" height="12">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z"/>
                            </svg>
                            <span class="badge-estado-texto">@estado</span>
                        </span>
                        @if (ViewBag.EsAdmin != null && (bool)ViewBag.EsAdmin)
                        {
                            <button class="btn btn-sm btn-danger ms-auto py-1 px-2" onclick="deleteContent(@Model.Reporte.Id, 'Reporte')" title="Eliminar Reporte completo" style="border-radius:10px;font-size:12px;">
                                <i class="bi bi-trash-fill"></i> Eliminar
                            </button>
                        }
                    </div>
                    <h1 class="detail-title">@Model.Reporte.Titulo</h1>
                    <p class="detail-time">
                        <i class="bi bi-clock me-1"></i> @tiempoTexto
                        @if (Model.Reporte.Usuario != null)
                        {
                            var autorNivel = BarrioInteligenteWeb.Services.ProfanityService.CalcularNivel(Model.Reporte.Usuario.PuntosReputacion).ToString();
                            <span class="ms-2">• Por <strong class="user-clickable text-white" data-user-id="@Model.Reporte.UsuarioId" data-user-nombre="@Model.Reporte.Usuario.NombreCompleto" data-user-foto="@(Model.Reporte.Usuario.FotoPerfil ?? "")" data-user-nivel="@autorNivel" data-user-miembro="@Model.Reporte.Usuario.FechaRegistro.ToString("MMMM yyyy")">@Model.Reporte.Usuario.NombreCompleto</strong></span>
                        }
                    </p>
                </div>
            </div>

            <!-- Cuerpo del Reporte -->
            <div class="detalle-card-body">
                <div class="detail-descripcion-box">
                    <h6 class="text-uppercase fw-bold text-muted mb-2" style="font-size: 11px; letter-spacing: 0.5px;">Descripción de la Incidencia</h6>
                    <p class="detail-descripcion">@Model.Reporte.Descripcion</p>
                </div>

                @if (esStaff)
                {
                    <div class="staff-estado-box" id="staffEstadoControl" data-reporte-id="@Model.Reporte.Id">
                        <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-2">
                            <div>
                                <h6 class="text-uppercase fw-bold text-muted mb-0" style="font-size: 11px; letter-spacing: 0.5px;">Gestión de Estado (Staff)</h6>
                                <small class="text-muted" style="font-size: 12px;">Actualiza el avance operativo del reporte</small>
                            </div>
                        </div>
                        <div class="d-flex flex-wrap gap-2">
                            @foreach (var opcion in new[] { "Pendiente", "En Proceso", "Resuelto" })
                            {
                                var esActual = string.Equals(estado, opcion, StringComparison.Ordinal);
                                var iconoEstado = opcion switch
                                {
                                    "Pendiente" => "⏳",
                                    "En Proceso" => "🛠️",
                                    "Resuelto" => "✅",
                                    _ => "•"
                                };
                                <button type="button"
                                        class="btn-estado-pill @(esActual ? "active" : "")"
                                        data-estado="@opcion">
                                    <span>@iconoEstado @opcion</span>
                                </button>
                            }
                        </div>
                        <div id="estado-feedback-alert" class="alert py-2 px-3 mt-3 mb-0 small d-none" role="alert"></div>
                    </div>
                }

                <!-- Botón de Confirmación Grande y Cómodo -->
                <div class="detail-confirmar-wrap mb-4">
                    <button type="button" 
                            id="btn-confirmar-detalle"
                            class="btn w-100 d-flex justify-content-center align-items-center gap-2 btn-confirmar-grande @(Model.YaVoto ? "activo" : "")" 
                            data-reporte-id="@Model.Reporte.Id">
                        <i class="bi @(Model.YaVoto ? "bi-heart-fill text-danger" : "bi-heart") icono-heart-detalle"></i>
                        <span class="texto-contador @(Model.YaVoto ? "text-danger fw-bold" : "")">
                            <span class="texto-estado">@(Model.YaVoto ? "¡Reporte Confirmado!" : "Confirmar y Validar este Reporte")</span> 
                            (<span class="conteo">@Model.Reporte.Upvotes</span> confirmaciones)
                        </span>
                    </button>
                </div>

                <!-- Encabezado de Comentarios -->
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h5 class="fw-bold mb-0" style="font-size: 16px; color: #111;">
                        💬 Conversación Comunitaria 
                        <span class="badge bg-light text-dark border ms-1" style="font-size: 12px;">@Model.Comentarios.Count</span>
                    </h5>
                    <span class="text-muted small">Sé respetuoso con tus vecinos</span>
                </div>

                <!-- Formulario de Nuevo Comentario (Espacioso) -->
                <form asp-controller="Reportes" asp-action="AgregarComentario" method="post" class="comment-composer-card mb-4">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="reporteId" value="@Model.Reporte.Id" />
                    <div class="d-flex gap-3 align-items-start">
                        <div class="comment-avatar flex-shrink-0" style="width: 42px; height: 42px; font-weight: 700;">
                            @if (!string.IsNullOrEmpty(ViewBag.FotoPerfil as string))
                            {
                                <img src="@ViewBag.FotoPerfil" alt="Yo" style="width:100%;height:100%;border-radius:50%;object-fit:cover;" />
                            }
                            else
                            {
                                <span>@(User.Identity?.Name?.Length > 0 ? User.Identity.Name[0].ToString().ToUpper() : "U")</span>
                            }
                        </div>
                        <div class="flex-grow-1 position-relative">
                            <textarea name="texto" class="form-control comment-textarea-modern" placeholder="Escribe un comentario o aporta detalles sobre este reporte..." rows="2" required></textarea>
                            <div class="d-flex justify-content-between align-items-center mt-2 flex-wrap gap-2">
                                <span class="text-muted small" style="font-size: 11px;">Moderación automática activa (lenguaje cívico)</span>
                                <button type="submit" class="btn btn-dark btn-sm px-4 py-2 rounded-pill d-flex align-items-center gap-2 fw-bold" style="background:#0f172a;">
                                    <span>Comentar</span>
                                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.2" stroke="currentColor" width="14" height="14">
                                        <path stroke-linecap="round" stroke-linejoin="round" d="M6 12 3.269 3.125A59.769 59.769 0 0 1 21.485 12 59.768 59.768 0 0 1 3.27 20.875L5.999 12Zm0 0h7.5"/>
                                    </svg>
                                </button>
                            </div>
                        </div>
                    </div>
                </form>

                <!-- Listado de Comentarios -->
                <div class="detail-comentarios-list">
                    @if (Model.Comentarios.Any())
                    {
                        @foreach (var comentario in Model.Comentarios)
                        {
                            var comRep = comentario.Usuario != null
                                ? BarrioInteligenteWeb.Services.ProfanityService.CalcularNivel(comentario.Usuario.PuntosReputacion)
                                : NivelReputacion.Regular;
                            var comRingClass = comRep switch {
                                NivelReputacion.Excelente => "avatar-excellent",
                                NivelReputacion.Buena     => "avatar-buena",
                                NivelReputacion.Regular   => "avatar-regular",
                                NivelReputacion.Mala      => "avatar-mala",
                                NivelReputacion.Critica   => "avatar-critica",
                                _ => ""
                            };
                            bool comEsExcelente = comRep == NivelReputacion.Excelente;
                            bool comTieneBadge  = comRep == NivelReputacion.Excelente || comRep == NivelReputacion.Buena;
                            var comNombre = comentario.Usuario?.NombreCompleto ?? "Usuario";
                            var comFoto = comentario.Usuario?.FotoPerfil ?? "";
                            var comNivel = comRep.ToString();
                            var comMiembro = comentario.Usuario?.FechaRegistro.ToString("MMMM yyyy") ?? "";
                            var comInicial = comNombre.Length > 0 ? comNombre[0].ToString().ToUpper() : "?";
                            var totalLikes = comentario.Likes?.Count ?? 0;
                            var estaLikeado = comentario.Likes?.Any(l => l.UsuarioId == currentUserId) ?? false;
                            <div class="comment-item">
                                <div class="avatar-wrapper @comRingClass user-clickable"
                                     data-user-id="@comentario.UsuarioId"
                                     data-user-nombre="@comNombre"
                                     data-user-foto="@comFoto"
                                     data-user-nivel="@comNivel"
                                     data-user-miembro="@comMiembro"
                                     title="Ver perfil de @comNombre">
                                    <div class="comment-avatar">
                                        @if (!string.IsNullOrEmpty(comentario.Usuario?.FotoPerfil))
                                        {
                                            <img src="@comentario.Usuario.FotoPerfil" alt="@comNombre"
                                                 style="width:100%;height:100%;border-radius:50%;object-fit:cover;" />
                                        }
                                        else
                                        {
                                            <span style="font-size:15px;font-weight:700;color:#555;">@comInicial</span>
                                        }
                                    </div>
                                    @if (comEsExcelente)
                                    {
                                        <div class="avatar-badge" title="Ciudadano Excelente">⭐</div>
                                    }
                                    else if (comTieneBadge)
                                    {
                                        <div class="avatar-badge" style="background:linear-gradient(135deg,#3b82f6,#2563eb);" title="Buena Reputación">🛡</div>
                                    }
                                </div>
                                <div class="comment-content">
                                    <p class="comment-user user-clickable"
                                       data-user-id="@comentario.UsuarioId"
                                       data-user-nombre="@comNombre"
                                       data-user-foto="@comFoto"
                                       data-user-nivel="@comNivel"
                                       data-user-miembro="@comMiembro">
                                        @comNombre
                                        @if (ViewBag.EsAdmin != null && (bool)ViewBag.EsAdmin)
                                        {
                                            <button class="btn btn-sm text-danger p-0 ms-2" onclick="event.stopPropagation(); deleteContent(@comentario.Id, 'Comentario')" title="Eliminar Comentario" style="border:none;background:none;">
                                                <i class="bi bi-trash-fill"></i>
                                            </button>
                                        }
                                    </p>
                                    <p class="comment-text">@comentario.Texto</p>
                                </div>
                                
                                <div class="btn-upvote btn-like-comentario" data-comentario-id="@comentario.Id" style="cursor:pointer;color:@(estaLikeado ? "#e74c3c" : "#ccc");display:flex;align-items:center;gap:4px;user-select:none;">
                                    @if(estaLikeado)
                                    {
                                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" width="18" height="18" class="heart-icon">
                                            <path d="m11.645 20.91-.007-.003-.022-.012a15.247 15.247 0 0 1-.383-.218 25.18 25.18 0 0 1-4.244-3.17C4.688 15.36 2.25 12.174 2.25 8.25 2.25 5.322 4.714 3 7.688 3A5.5 5.5 0 0 1 12 5.052 5.5 5.5 0 0 1 16.313 3c2.973 0 5.437 2.322 5.437 5.25 0 3.925-2.438 7.111-4.739 9.256a25.175 25.175 0 0 1-4.244 3.17 15.247 15.247 0 0 1-.383.219l-.022.012-.007.004-.003.001a.752.752 0 0 1-.704 0l-.003-.001Z" />
                                        </svg>
                                    }
                                    else
                                    {
                                        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" width="18" height="18" class="heart-icon">
                                            <path stroke-linecap="round" stroke-linejoin="round" d="M21 8.25c0-2.485-2.099-4.5-4.688-4.5-1.935 0-3.597 1.126-4.312 2.733-.715-1.607-2.377-2.733-4.313-2.733C5.1 3.75 3 5.765 3 8.25c0 7.22 9 12 9 12s9-4.78 9-12Z"/>
                                        </svg>
                                    }
                                    <span class="likes-count" style="font-size:12px;font-weight:600;">@totalLikes</span>
                                </div>
                            </div>
                        }
                    }
                    else
                    {
                        <div class="text-center py-4 my-2 rounded-3 bg-light border border-dashed">
                            <p class="text-muted mb-0 small">Sé el primero en comentar y aportar a tu vecindario.</p>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

    @await Html.PartialAsync("_BottomNav")
</div>

@await Html.PartialAsync("_UserProfileModal")

<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
<script>
    document.addEventListener("DOMContentLoaded", function () {
        // ═════════════════════════════════════════
        // LIKES DE COMENTARIOS (existente)
        // ═════════════════════════════════════════
        const likeButtons = document.querySelectorAll('.btn-like-comentario');
        
        likeButtons.forEach(btn => {
            btn.addEventListener('click', async function () {
                const comentarioId = this.dataset.comentarioId;
                const url = '@Url.Action("ToggleLikeComentario", "Reportes")';
                const token = document.querySelector('input[name="__RequestVerificationToken"]').value;
                
                // Animacion
                this.style.transform = 'scale(1.2)';
                setTimeout(() => this.style.transform = 'scale(1)', 150);
                this.style.transition = 'transform 0.15s ease-out';

                try {
                    const formData = new FormData();
                    formData.append('id', comentarioId);
                    
                    const response = await fetch(url, {
                        method: 'POST',
                        body: formData,
                        headers: {
                            'RequestVerificationToken': token,
                            'X-Requested-With': 'XMLHttpRequest'
                        }
                    });
                    
                    if (response.ok) {
                        const data = await response.json();
                        if (data.success) {
                            const countSpan = this.querySelector('.likes-count');
                            countSpan.textContent = data.totalLikes;
                            
                            if (data.estaLikeado) {
                                this.style.color = '#e74c3c';
                                this.innerHTML = `
                                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" width="18" height="18" class="heart-icon">
                                        <path d="m11.645 20.91-.007-.003-.022-.012a15.247 15.247 0 0 1-.383-.218 25.18 25.18 0 0 1-4.244-3.17C4.688 15.36 2.25 12.174 2.25 8.25 2.25 5.322 4.714 3 7.688 3A5.5 5.5 0 0 1 12 5.052 5.5 5.5 0 0 1 16.313 3c2.973 0 5.437 2.322 5.437 5.25 0 3.925-2.438 7.111-4.739 9.256a25.175 25.175 0 0 1-4.244 3.17 15.247 15.247 0 0 1-.383.219l-.022.012-.007.004-.003.001a.752.752 0 0 1-.704 0l-.003-.001Z" />
                                    </svg>
                                    <span class="likes-count" style="font-size:12px;font-weight:600;">${data.totalLikes}</span>
                                `;
                            } else {
                                this.style.color = '#ccc';
                                this.innerHTML = `
                                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" width="18" height="18" class="heart-icon">
                                        <path stroke-linecap="round" stroke-linejoin="round" d="M21 8.25c0-2.485-2.099-4.5-4.688-4.5-1.935 0-3.597 1.126-4.312 2.733-.715-1.607-2.377-2.733-4.313-2.733C5.1 3.75 3 5.765 3 8.25c0 7.22 9 12 9 12s9-4.78 9-12Z"/>
                                    </svg>
                                    <span class="likes-count" style="font-size:12px;font-weight:600;">${data.totalLikes}</span>
                                `;
                            }
                        }
                    }
                } catch (error) {
                    console.error('Error al hacer toggle like:', error);
                }
            });
        });

        // Script para confirmar reporte en Detalles (AJAX similar a Comunidad)
        const btnConfirmarDetalle = document.getElementById('btn-confirmar-detalle');
        if (btnConfirmarDetalle) {
            btnConfirmarDetalle.addEventListener('click', async function(e) {
                e.preventDefault();
                const reporteId = this.getAttribute('data-reporte-id');
                const token = document.querySelector('input[name="__RequestVerificationToken"]').value;

                // Animacion sutil
                this.style.transform = 'scale(0.98)';
                setTimeout(() => this.style.transform = 'scale(1)', 150);
                this.style.transition = 'transform 0.15s ease-out';

                try {
                    const formData = new FormData();
                    formData.append('id', reporteId);

                    const response = await fetch('@Url.Action("ConfirmarReporte", "Reportes")', {
                        method: 'POST',
                        headers: {
                            'RequestVerificationToken': token,
                            'X-Requested-With': 'XMLHttpRequest'
                        },
                        body: formData
                    });

                    if (response.ok) {
                        const data = await response.json();
                        if (data.success) {
                            const icono = this.querySelector('i.bi');
                            const textoContador = this.querySelector('.texto-contador');
                            const spanConteo = this.querySelector('.conteo');
                            const textoEstado = this.querySelector('.texto-estado');

                            spanConteo.textContent = data.nuevoConteo;

                            if (data.estaConfirmado) {
                                icono.classList.remove('bi-heart');
                                icono.classList.add('bi-heart-fill', 'text-danger');
                                textoContador.classList.add('text-danger', 'fw-bold');
                                textoEstado.textContent = 'Confirmado';
                            } else {
                                icono.classList.remove('bi-heart-fill', 'text-danger');
                                icono.classList.add('bi-heart');
                                textoContador.classList.remove('text-danger', 'fw-bold');
                                textoEstado.textContent = 'Confirmar Reporte';
                            }
                        } else {
                            alert(data.message || 'Error al procesar la confirmación.');
                        }
                    }
                } catch (error) {
                    console.error('Error al confirmar reporte:', error);
                }
            });
        }

        // Cambio de estado (Staff/Admin)
        const staffControl = document.getElementById('staffEstadoControl');
        if (staffControl) {
            const pills = staffControl.querySelectorAll('.btn-estado-pill');
            const feedbackAlert = document.getElementById('estado-feedback-alert');
            const badgeEstado = document.getElementById('badge-estado-detalle');
            const badgeEstadoTexto = badgeEstado ? badgeEstado.querySelector('.badge-estado-texto') : null;
            const reporteId = staffControl.dataset.reporteId;

            const mostrarFeedbackEstado = (mensaje, esExito) => {
                if (!feedbackAlert) return;
                feedbackAlert.className = `alert py-2 px-3 mt-3 mb-0 small ${esExito ? 'alert-success' : 'alert-danger'}`;
                feedbackAlert.textContent = mensaje;
            };

            const obtenerClaseEstado = (est) => {
                if (est === 'Resuelto') return 'resuelto';
                if (est === 'En Proceso') return 'en-proceso';
                return 'pendiente';
            };

            pills.forEach(btn => {
                btn.addEventListener('click', async function () {
                    const nuevoEstado = this.dataset.estado;
                    const tokenInput = document.querySelector('input[name="__RequestVerificationToken"]');
                    const token = tokenInput ? tokenInput.value : '';

                    pills.forEach(p => p.disabled = true);
                    try {
                        const formData = new FormData();
                        formData.append('id', reporteId);
                        formData.append('nuevoEstado', nuevoEstado);

                        const response = await fetch('@Url.Action("CambiarEstado", "Reportes")', {
                            method: 'POST',
                            headers: {
                                'RequestVerificationToken': token,
                                'X-Requested-With': 'XMLHttpRequest'
                            },
                            body: formData
                        });

                        const data = await response.json();
                        if (response.ok && data.success) {
                            pills.forEach(p => p.classList.toggle('active', p.dataset.estado === data.estado));
                            if (badgeEstado) {
                                badgeEstado.classList.remove('pendiente', 'en-proceso', 'resuelto');
                                badgeEstado.classList.add(obtenerClaseEstado(data.estado));
                            }
                            if (badgeEstadoTexto) {
                                badgeEstadoTexto.textContent = data.estado;
                            }
                            mostrarFeedbackEstado(data.message || `Estado actualizado a ${data.estado}.`, true);
                        } else {
                            mostrarFeedbackEstado(data.message || 'No se pudo actualizar el estado.', false);
                        }
                    } catch (err) {
                        console.error('Error al cambiar estado:', err);
                        mostrarFeedbackEstado('Error de conexión al actualizar el estado.', false);
                    } finally {
                        pills.forEach(p => p.disabled = false);
                    }
                });
            });
        }
    });

    async function deleteContent(id, tipo) {
        if (!confirm('¿Seguro que deseas eliminar este ' + tipo.toLowerCase() + ' de la plataforma?')) return;
        const token = document.querySelector('input[name="__RequestVerificationToken"]').value;
        const formData = new FormData();
        formData.append('id', id);
        formData.append('tipo', tipo);

        try {
            const res = await fetch('/Admin/EliminarContenido', {
                method: 'POST', headers: { 'RequestVerificationToken': token }, body: formData
            });
            const data = await res.json();
            if (data.success) {
                alert(data.message);
                if(tipo === 'Reporte') {
                    window.location.href = '/Reportes/Index';
                } else {
                    location.reload();
                }
            } else {
                alert(data.message);
            }
        } catch(e) { console.error(e); }
    }
</script>
</body>
</html>
